---
interface Props {
  id: string;
  title: string;
  kicker: string;
}

const { id, title, kicker } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="reveal">
  <p class="kicker">{kicker}</p>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  section {
    padding-block: clamp(3rem, 8vw, 5rem);
  }
  .kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin: 0 0 2rem;
  }
</style>
